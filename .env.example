# 1. Make a copy of this file and name the copy:  .env.local
# 2. Paste your values from the Supabase dashboard (Connect button, or
#    Project Settings > API Keys).
# The publishable key is safe to use in a browser. Never put a "secret"
# key in this project.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
